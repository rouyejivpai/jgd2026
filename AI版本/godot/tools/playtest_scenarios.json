  "_comment": "脚本化试玩场景（00 M8 / 05 §5；第二阶段 P3 改为单位列表格式）：每关 recommended + alternative（+ expected_fail 供报告对照）。由 tools/run_playtests.gd 读取，输出 docs/playtests/<level>_<kind>.json。units 按出场顺序列出（free 关依次分配 u1、u2…；fixed 关写 slot），每个单位必须显式给出 rules（新放置单位指令为空）；可选 copy_route（复制预设路线为信标）与 beacons [[x,y],…]。规则可写 rule_library 键名或 route:<id> / route_loop:<id> / beacons_<once|loop|pingpong>:<起点编号> / wait_at:<信标编号>:<秒>（第三阶段起信标为数字编号 1、2…）。",
  "rule_library": {
    "atk": { "conditions": [{ "type": "enemy_in_range" }], "target": { "selector": "nearest", "filter": "any" }, "action": { "type": "attack" } },
    "atk_unit": { "conditions": [{ "type": "enemy_in_range" }], "target": { "selector": "nearest", "filter": "unit" }, "action": { "type": "attack" } },
    "chase": { "conditions": [{ "type": "enemy_visible" }], "target": { "selector": "nearest", "filter": "any" }, "action": { "type": "chase_attack" } },
    "chase_unit": { "conditions": [{ "type": "enemy_visible" }], "target": { "selector": "nearest", "filter": "unit" }, "action": { "type": "chase_attack" } },
    "retreat_low_hp": { "conditions": [{ "type": "self_hp_below", "ratio": 0.3 }], "action": { "type": "retreat" } },
    "idle": { "conditions": [], "action": { "type": "idle" } },
    "chase_off": { "enabled": false, "conditions": [{ "type": "enemy_visible" }], "target": { "selector": "nearest", "filter": "any" }, "action": { "type": "chase_attack" } },
    "chase_unit_off": { "enabled": false, "conditions": [{ "type": "enemy_visible" }], "target": { "selector": "nearest", "filter": "unit" }, "action": { "type": "chase_attack" } },
    "atk_structure": { "conditions": [{ "type": "enemy_in_range" }], "target": { "selector": "nearest", "filter": "structure" }, "action": { "type": "attack" } },
    "approach_unit": { "conditions": [{ "type": "enemy_visible" }], "target": { "selector": "nearest", "filter": "unit" }, "action": { "type": "chase" } },
    "kite_unit_3": { "conditions": [{ "type": "target_distance", "op": "<", "value": 3 }], "target": { "selector": "nearest", "filter": "unit" }, "action": { "type": "retreat" } }
  },
