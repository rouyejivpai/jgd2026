  "objectives": {
    "objective_text": "畸变母核在两圈回廊的最里面。外圈门在下、内圈门在右；两名巡逻者在回廊里逆时针绕圈。拆掉它。",
    "win": [
      {
        "id": "win_heart",
        "type": "destroy",
        "targets": [
          "HEART"
        ]
      }
    ],
    "lose": [
      {
        "id": "lose_all_dead",
        "type": "all_allies_dead"
      }
    ]
  },
  "verification": {
    "expected_win": "快速形态开局立刻进门、向右、上到内圈门 (15,8)：巡逻者甲在它身后、乙已往上走过门口，两人都追不上；进内圈打温室之心。",
    "expected_fail": [
      "在门外等：巡逻者沿外墙转到门口时隔着门看见它（视野 3.2），追出门外咬死（约 8.6 秒）。"
    ],
    "alternatives": [
      "立刻走左路也能过（路更长，约 28 秒）——两条路都通，考的是「别在门口磨蹭」。"
    ],
    "risks": [
      "多圈回廊是评审建议的形状之一；尺寸、门的位置可以在编辑器里继续调。",
      "仿真里「立刻进」是关键（左右都行）；如果希望「等待时机」也成为解，需要把门外等候点挪到巡逻者视野外。"
    ],
    "_engine_check": "2026-10-14 用原型模拟核心（AI版本/godot，补状态系统后）无头实跑，结果见《关卡修改报告》",
    "_note_20261018": "移动改直线后，原回廊只有 2–3 格宽、巡逻者视野 3.5，会隔墙看见圈外 / 内圈的人并直线撞墙（门外等的反例里巡逻者卡在门边，反例反而能赢）。改为：外圈下门 1 格 → 3 格 (10–12,2)；内圈上下墙加厚为两层、四角削掉；巡逻路线贴外墙走 (4,3)→(18,3)→(18,13)→(4,13)，每 3 格一个路点（追完人回路线时下一个路点就在附近，不会被内圈墙角挡住）；视野 3.5→3.2（只能隔着门看到门外等候的人）。三个用例结论不变，无头实跑 0 卡墙。 部署区 (9–13,0) → (11–13,0)：巡逻者从左往右经过下门时，第一眼看到 (9,0)/(10,0) 的人会斜着撞到门左侧墙角。"
  },
