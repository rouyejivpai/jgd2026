  "verification": {
    "expected_win": "两名基础形态分别沿环廊左、右两侧往上走，看见猎犬就追：猎犬被两头的合力夹在上方走廊，往两侧逃会钻进缓滞带，被困后反咬、被收掉。",
    "expected_fail": [],
    "alternatives": [
      "两人从同一头追也能赢，但慢（有缓滞带约 16 秒、没有约 15 秒，包夹约 10 秒）。"
    ],
    "risks": [
      "逃跑规则（向量之和）为本版定义，原型需同步实现（补丁已给）。",
      "【仿真发现】按「投影最大、不更靠近威胁」的规则，猎犬在环廊**拐角**会把自己困住（往前投影为负、往侧面投影为 0），所以单向追也能在拐角堵住它——「追不上」并不成立。若要强制包夹，需要给向量规则补「贴墙滑行」（合力被墙挡住时取沿墙分量）——这正是评审列为未定的「墙体处理」，请在规则表里拍板。"
    ],
    "_engine_check": "2026-10-14 用原型模拟核心（AI版本/godot，补状态系统后）无头实跑，结果见《关卡修改报告》"
  },
