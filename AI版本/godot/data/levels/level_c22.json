  "verification": {
    "expected_win": "远射走到 (8,5)（离骨喉 7 格）按「最远」先点骨喉；快速形态在 x=4..5 绕圈（仍在骨喉 12 格射程内）当最远者引雷；承伤与基础形态追猎犬，猎犬往右逃进角落缓滞带后被收掉。",
    "expected_fail": [
      "全员待在部署区：骨喉的雷一发发砸在最远的人身上，猎犬不靠近也不离开，打不完。"
    ],
    "alternatives": [
      "仿真三种顺序都能赢：先拆雷+引雷+追猎、只引雷不专门拆雷、四人直接冲（不引雷）——直接冲最快：骨喉只有 60 血，冲得快就来不及砸第二轮（具体秒数见《关卡修改报告》）。"
    ],
    "risks": [
      "评审说顺序「需要实测」：原型模拟核心的实测是「直接冲」最快。若希望引雷/拆雷更有意义，可把骨喉血量提到 120 或增加第二具骨喉，留给试玩决定。"
    ],
    "_engine_check": "2026-10-14 用原型模拟核心（AI版本/godot，补状态系统后）无头实跑，结果见《关卡修改报告》"
  },
